   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv('all_recs.csv', encoding='latin-1')\n",
    "\n",
    "df['Industry'].value_counts().plot(kind='barh', figsize=(8,8))\n",
    "plt.title('Number of Records by Industry')\n",
    "plt.xlabel('Count')\n",
    "plt.ylabel('Industry')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
